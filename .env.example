# ============================================
# VideoSLK Bot — Environment Variables
# Copy this file to `.env` and fill in real values.
# See ENV_SETUP.md for full instructions.
# NEVER commit .env to git — it's already in .gitignore.
# ============================================

# ===== Telegram bot core =====
BOT_TOKEN=123456:replace_me_with_token_from_BotFather
ADMIN_ID=000000000

# ===== Free channel (gets 5-8s preview + website link) =====
FREE_CHANNEL_ID=-1001000000000
FREE_CHANNEL_USERNAME=your_free_channel

# ===== Premium channel (auto-receives full video, Stars-gated) =====
PREMIUM_CHANNEL_ID=-1001000000000
PREMIUM_CHANNEL_USERNAME=your_premium_channel
PREMIUM_INVITE_LINK=https://t.me/+REPLACE_ME
PREMIUM_STARS_PRICE=150

# ===== GitHub (bot pushes site files here) =====
GITHUB_TOKEN=ghp_replace_me_with_fine_grained_PAT
GITHUB_REPO=your-username/VideoLK
GITHUB_BRANCH=main

# ===== Site =====
SITE_URL=https://your-site.example.com
BOT_LINK=https://t.me/your_bot

# ===== Anti-bypass: HMAC unlock token =====
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value here AND in Cloudflare Pages env (UNLOCK_HMAC_SECRET)
UNLOCK_HMAC_SECRET=replace_me_with_32_char_random_hex
UNLOCK_TOKEN_MAX_AGE_SEC=600

# ===== Cloudflare Turnstile (optional, public site key) =====
TURNSTILE_SITE_KEY=

# ===== Tuning (optional) =====
FREE_CHANNEL_POST_DELAY_MS=60000
